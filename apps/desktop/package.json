{
  "name": "@dream/desktop",
  "private": true,
  "version": "5.6.0",
  "type": "module",
  "description": "Dream desktop shell — Tauri 2 + vanilla ES modules (v5 agent workbench)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"scripts/**/*.mjs\"",
    "tokens:check": "node scripts/validate-tokens.mjs",
    "performance:check": "node --expose-gc scripts/perf-check.mjs",
    "accessibility:check": "vitest run src/v5/a11y.test.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/source-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
