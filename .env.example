# Which backend Dream talks to: echo | openai | ollama | aval
DREAM_BACKEND=echo

# Which user the memories belong to; the store separates tenants by this id.
DREAM_USER=local

# Path to the SQLite memory database.
DREAM_DB=data/dream.db

# Sampling temperature for the conversational call, 0.0 to 2.0.
# Anything missing, non-numeric, or out of range falls back to the default.
# DREAM_TEMPERATURE=0.3

# Maximum characters of complete recalled-memory lines added to one prompt.
# Invalid values fall back to the default of 8000.
# DREAM_MEMORY_BLOCK_CHAR_LIMIT=8000

# Retry attempts for HTTP 429 rate limits, with exponential backoff.
# Only 429 is retried; a hanging provider is bounded by the per-request
# timeout instead. Invalid values fall back to 3.
# DREAM_MAX_RETRIES=3

# Base backoff sleep before the first retry, in seconds; each retry doubles it.
# DREAM_RETRY_BACKOFF_SECONDS=1.0

# Wall-clock budget, in seconds, a turn waits for the background extraction
# pass before marking it abandoned and returning the reply anyway.
# DREAM_EXTRACTION_TIMEOUT_SECONDS=5.0

# Allow the guarded search_web and read_page tools to reach public HTTP(S)
# addresses. Off by default; set true only when the owner approves network use.
# DREAM_ALLOW_NETWORK=true

# Google Workspace (read-only Gmail / Calendar / Drive). Desktop OAuth client.
# Redirect must stay http://127.0.0.1:17463/callback. Tokens go to the OS keychain.
# DREAM_GOOGLE_CLIENT_ID=
# DREAM_GOOGLE_CLIENT_SECRET=

# Minimum leading-token overlap for semantic contradiction detection, 0.0 to 1.0.
# Invalid values fall back to the conservative default of 0.8.
# DREAM_CONTRADICTION_THRESHOLD=0.8

# Path to a JSON file of extra Persian synonym groups for recall query expansion.
# The file must hold a JSON list of groups, each group a list of strings.
# Missing, unreadable or malformed files fall back to the built-in table.
# DREAM_SYNONYMS=

# --- OpenAI-compatible endpoint -------------------------------------------
# These are the exact names the backend reads; older drafts of this file
# documented different names that the code never looked at.
# DREAM_BACKEND=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-replace-me
# DREAM_MODEL=gpt-4o-mini

# --- Aval AI (Iranian cloud provider) ---------------------------------------
# Aval is the recommended hosted path for Iranian users: one key from
# https://chat.avalai.ir/platform/home, many model families behind one
# OpenAI-compatible endpoint at https://api.avalai.ir/v1. Aval also documents
# a fallback host, https://api.avalapis.ir/v1; it is recognised for routing
# but never probed by Dream. The router names the aval route when this key is
# set, when OPENAI_BASE_URL points at api.avalai.ir / api.avalapis.ir, or when
# DREAM_BACKEND is aval/avalai. The key is read from the environment only and
# never logged; the desktop stores it through the OS keychain when you add the
# Aval card from the Providers page.
# AVALAI_API_KEY=

# --- Ollama ----------------------------------------------------------------
# The model name is read from DREAM_MODEL here too (default llama3.2).
# DREAM_BACKEND=ollama
# OLLAMA_HOST=http://localhost:11434
# DREAM_MODEL=llama3.2

# --- Plans and the usage ledger -------------------------------------------
# Active plan: local (unlimited, free) | guest (free daily quota) |
# daily | individual_monthly | individual_yearly | team | company.
# Currency is IRR; only local and guest are free (price 0). Paid-plan prices
# are TBD after cost measurement and are stored as null, never invented.
# DREAM_PLAN=local

# Path to the JSON usage ledger. Required for metered plans; the unlimited
# local plan needs no ledger file. Dream.run consumes one turn per message
# only when a ledger is attached (DREAM_PLAN not local, or DREAM_LEDGER set).
# Metered plans fail closed: an unreadable or corrupt ledger refuses turns.
# DREAM_LEDGER=data/dream-ledger.json
