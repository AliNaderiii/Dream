{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dream",
  "version": "0.3.2",
  "identifier": "com.dream.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ./scripts/bundle-sidecar.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Dream",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "theme": null,
        "visible": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "trayIcon": {
      "id": "dream-tray",
      "iconPath": "icons/tray/tray-32.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Dream"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Dream",
    "copyright": "Copyright \u00a9 2026 Dream. All rights reserved.",
    "category": "Productivity",
    "shortDescription": "A personal AI assistant with first-class Persian support.",
    "longDescription": "Dream is a personal AI assistant with durable memory, typed tools, and first-class Persian language support. It runs locally, keeps its memory on your machine, and asks before it does anything irreversible.",
    "homepage": "https://github.com/AliNaderiii/Dream",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/python/**/*"],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        },
        "windowSize": {
          "width": 660,
          "height": 420
        }
      },
      "files": {},
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "linux/dream.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3"
        ],
        "epoch": 0,
        "release": "1",
        "desktopTemplate": "linux/dream.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFRkIyQjYwN0E3Qjc3NkMKUldSc2QzdDZZQ3Y3L3BoRzlFbGhuWDNYd3FMR3FQcU53aXh0TUszaGkranVkZ3RlNWZoei9KNE8K",
      "endpoints": [
        "https://github.com/AliNaderiii/Dream/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
