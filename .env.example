# Which backend Dream talks to: echo | openai | ollama
DREAM_BACKEND=echo

# Who the assistant belongs to; used to personalise replies.
DREAM_OWNER=Ali

# Path to the SQLite memory database.
DREAM_DB=data/dream.db

