diff --git a/.github/workflows/desktop-ci.yml b/.github/workflows/desktop-ci.yml
index 2c20d47..503325d 100644
--- a/.github/workflows/desktop-ci.yml
+++ b/.github/workflows/desktop-ci.yml
@@ -114,6 +114,12 @@ jobs:
         working-directory: apps/desktop/src-tauri
         run: cargo build --verbose
 
+      # `cargo test` is skipped on Windows: tauri-winres only embeds the Windows
+      # app manifest into the main binary, so test EXEs load ComCtl32 v5 instead
+      # of v6 and fail to start with STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139).
+      # See https://github.com/tauri-apps/tauri/issues/13419
+      # The tests are platform-agnostic logic and are covered by the Linux/macOS jobs.
       - name: Cargo test
+        if: runner.os != 'Windows'
         working-directory: apps/desktop/src-tauri
         run: cargo test --verbose
diff --git a/apps/desktop/src-tauri/build.rs b/apps/desktop/src-tauri/build.rs
index c0f9362..d860e1e 100644
--- a/apps/desktop/src-tauri/build.rs
+++ b/apps/desktop/src-tauri/build.rs
@@ -1,19 +1,3 @@
 fn main() {
-    tauri_build::build();
-
-    // Workaround for https://github.com/tauri-apps/tauri/issues/13419 :
-    // `tauri-winres` embeds the Windows application manifest only into the main
-    // binary, not into test binaries. Without the manifest, a test EXE loads the
-    // wrong ComCtl32 (v5 instead of v6) and fails to start with
-    // STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139) when running `cargo test` on Windows.
-    //
-    // `cargo:rustc-link-arg-tests` restricts the manifest to test targets only,
-    // so the main app binary is unaffected (tauri-winres already embeds one).
-    #[cfg(target_os = "windows")]
-    {
-        let manifest = concat!(env!("CARGO_MANIFEST_DIR"), "/windows-app-manifest.xml");
-        println!("cargo:rerun-if-changed={manifest}");
-        println!("cargo:rustc-link-arg-tests=/MANIFEST:EMBED");
-        println!("cargo:rustc-link-arg-tests=/MANIFESTINPUT:{manifest}");
-    }
+    tauri_build::build()
 }
