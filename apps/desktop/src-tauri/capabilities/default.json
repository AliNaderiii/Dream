{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline capability for Dream windows. Grants only what the shell needs: no shell execution, no arbitrary filesystem access, no HTTP client. Every dangerous operation goes through an audited Rust command instead.",
  "windows": ["main", "dream-*"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "core:app:allow-name",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:window:allow-is-maximized",
    "core:window:allow-is-minimized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-focused",
    "core:window:allow-is-visible",
    "core:window:allow-theme",
    "core:window:allow-set-theme",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",
    "os:allow-platform",
    "os:allow-os-type",
    "os:allow-version",
    "os:allow-locale",
    "process:allow-restart",
    "process:allow-exit",
    "store:default",
    "dialog:default",
    "notification:default",
    "updater:default"
  ]
}
