+          import pathlib
+          import sys
+
+          root = pathlib.Path("apps/desktop/src-tauri/target")
+          if not root.exists():
+              print("No target directory — nothing to checksum")
+              sys.exit(0)
+          names = []
+          for path in sorted(root.rglob("*")):
+              if not path.is_file():
+                  continue
+              name = path.name
+              if name.endswith("-setup.exe") or path.suffix in {
+                  ".deb",
+                  ".rpm",
+                  ".AppImage",
+                  ".dmg",
